{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://martixdev.github.io/ai-dev-strategy/control-plane/issue-schema.json",
  "title": "Issue Lifecycle Control Plane Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objective",
    "acceptance_criteria",
    "test_intent",
    "data_sensitivity",
    "dependency_metadata",
    "primary_execution_lane",
    "triage_labels"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "test_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "focus"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "unit",
            "integration",
            "e2e",
            "mixed"
          ]
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "data_sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "dependency_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_by",
        "blocks",
        "external_dependencies"
      ],
      "properties": {
        "blocked_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issueRef"
          },
          "uniqueItems": true
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issueRef"
          },
          "uniqueItems": true
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        }
      }
    },
    "primary_execution_lane": {
      "type": "string",
      "enum": [
        "cloud-first",
        "local-first-lenovo-p52",
        "local-first-gigabyte"
      ]
    },
    "triage_labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "needs-triage",
          "needs-info",
          "ready-for-agent",
          "ready-for-human",
          "wontfix"
        ]
      }
    },
    "variant": {
      "type": "string",
      "enum": [
        "cloud-first",
        "local-first"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "primary_execution_lane": {
            "const": "cloud-first"
          }
        },
        "required": [
          "primary_execution_lane"
        ]
      },
      "then": {
        "properties": {
          "variant": {
            "const": "cloud-first"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "primary_execution_lane": {
            "enum": [
              "local-first-lenovo-p52",
              "local-first-gigabyte"
            ]
          }
        },
        "required": [
          "primary_execution_lane"
        ]
      },
      "then": {
        "properties": {
          "variant": {
            "const": "local-first"
          }
        }
      }
    }
  ],
  "$defs": {
    "issueRef": {
      "type": "string",
      "pattern": "^#[1-9][0-9]*$"
    }
  }
}
