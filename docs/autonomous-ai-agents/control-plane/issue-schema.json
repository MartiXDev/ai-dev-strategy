{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://martixdev.github.io/ai-dev-strategy/control-plane/issue-schema.json",
  "title": "Issue Lifecycle Control Plane Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objective",
    "acceptance_criteria",
    "test_intent",
    "data_sensitivity",
    "dependency_metadata",
    "variant",
    "routing_profile",
    "primary_execution_lane",
    "triage_labels"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "test_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "focus"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "unit",
            "integration",
            "e2e",
            "mixed"
          ]
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "data_sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "dependency_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_by",
        "blocks",
        "external_dependencies"
      ],
      "properties": {
        "blocked_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issueRef"
          },
          "uniqueItems": true
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issueRef"
          },
          "uniqueItems": true
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        }
      }
    },
    "routing_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_class",
        "hardware_affinity",
        "cost_posture"
      ],
      "properties": {
        "workload_class": {
          "type": "string",
          "enum": [
            "lightweight",
            "standard",
            "heavy",
            "batch"
          ]
        },
        "hardware_affinity": {
          "type": "string",
          "enum": [
            "none",
            "lenovo-p52",
            "gigabyte"
          ]
        },
        "cost_posture": {
          "type": "string",
          "enum": [
            "minimize-cost",
            "balanced",
            "throughput-priority"
          ]
        }
      }
    },
    "primary_execution_lane": {
      "type": "string",
      "enum": [
        "cloud-first",
        "local-first-lenovo-p52",
        "local-first-gigabyte"
      ]
    },
    "triage_labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "needs-triage",
          "needs-info",
          "ready-for-agent",
          "ready-for-human",
          "wontfix"
        ]
      }
    },
    "variant": {
      "type": "string",
      "enum": [
        "cloud-first",
        "local-first"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "variant": {
            "const": "cloud-first"
          }
        },
        "required": [
          "variant"
        ]
      },
      "then": {
        "properties": {
          "routing_profile": {
            "type": "object",
            "properties": {
              "hardware_affinity": {
                "const": "none"
              }
            },
            "required": [
              "hardware_affinity"
            ]
          },
          "primary_execution_lane": {
            "const": "cloud-first"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "local-first"
          }
        },
        "required": [
          "variant"
        ]
      },
      "then": {
        "properties": {
          "primary_execution_lane": {
            "enum": [
              "local-first-lenovo-p52",
              "local-first-gigabyte"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "local-first"
          },
          "routing_profile": {
            "type": "object",
            "properties": {
              "hardware_affinity": {
                "const": "lenovo-p52"
              }
            },
            "required": [
              "hardware_affinity"
            ]
          }
        },
        "required": [
          "variant",
          "routing_profile"
        ]
      },
      "then": {
        "properties": {
          "routing_profile": {
            "type": "object",
            "properties": {
              "workload_class": {
                "const": "lightweight"
              }
            },
            "required": [
              "workload_class"
            ]
          },
          "primary_execution_lane": {
            "const": "local-first-lenovo-p52"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "local-first"
          },
          "routing_profile": {
            "type": "object",
            "properties": {
              "hardware_affinity": {
                "const": "gigabyte"
              }
            },
            "required": [
              "hardware_affinity"
            ]
          }
        },
        "required": [
          "variant",
          "routing_profile"
        ]
      },
      "then": {
        "properties": {
          "primary_execution_lane": {
            "const": "local-first-gigabyte"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "local-first"
          },
          "routing_profile": {
            "type": "object",
            "properties": {
              "workload_class": {
                "const": "lightweight"
              },
              "hardware_affinity": {
                "const": "none"
              },
              "cost_posture": {
                "enum": [
                  "minimize-cost",
                  "balanced"
                ]
              }
            },
            "required": [
              "workload_class",
              "hardware_affinity",
              "cost_posture"
            ]
          }
        },
        "required": [
          "variant",
          "routing_profile"
        ]
      },
      "then": {
        "properties": {
          "primary_execution_lane": {
            "const": "local-first-lenovo-p52"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "local-first"
          }
        },
        "allOf": [
          {
            "properties": {
              "routing_profile": {
                "type": "object",
                "properties": {
                  "hardware_affinity": {
                    "const": "none"
                  }
                },
                "required": [
                  "hardware_affinity"
                ]
              }
            }
          },
          {
            "anyOf": [
              {
                "properties": {
                  "routing_profile": {
                    "type": "object",
                    "properties": {
                      "workload_class": {
                        "enum": [
                          "standard",
                          "heavy",
                          "batch"
                        ]
                      }
                    },
                    "required": [
                      "workload_class"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "routing_profile": {
                    "type": "object",
                    "properties": {
                      "cost_posture": {
                        "const": "throughput-priority"
                      }
                    },
                    "required": [
                      "cost_posture"
                    ]
                  }
                }
              }
            ]
          }
        ],
        "required": [
          "variant",
          "routing_profile"
        ]
      },
      "then": {
        "properties": {
          "primary_execution_lane": {
            "const": "local-first-gigabyte"
          }
        }
      }
    }
  ],
  "$defs": {
    "issueRef": {
      "type": "string",
      "pattern": "^#[1-9][0-9]*$"
    }
  }
}
